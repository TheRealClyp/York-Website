// York site generator — builds the York landing page into index.html.
// Run:  york run
// This page is generated by York itself.

public static void line(String text) {
    append_file("index.html", text);
    append_file("index.html", "\n");
}

// ---------------------------------------------------------------------------
// <head>  —  meta, fonts, and the whole design system
// ---------------------------------------------------------------------------
public static void head() {
    line("<!DOCTYPE html>");
    line("<html lang='en'>");
    line("<head>");
    line("<meta charset='utf-8'>");
    line("<meta name='viewport' content='width=device-width, initial-scale=1'>");
    line("<title>York — a fast, simple systems language</title>");
    line("<meta name='description' content='York is a fast, simple systems language: clean syntax, arena memory, and a single native binary. No runtime, no garbage collector. Free Windows binaries.'>");
    line("<meta name='theme-color' content='#04060c'>");
    line("<link rel='canonical' href='https://therealclyp.github.io/York-Website/'>");
    line("<meta property='og:type' content='website'>");
    line("<meta property='og:url' content='https://therealclyp.github.io/York-Website/'>");
    line("<meta property='og:site_name' content='York'>");
    line("<meta property='og:title' content='York — one language, zero magic'>");
    line("<meta property='og:description' content='Fast, simple systems language. Clean syntax, arena memory, single native binary. Free Windows binaries.'>");
    line("<link rel='preconnect' href='https://fonts.googleapis.com'>");
    line("<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>");
    line("<link href='https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap' rel='stylesheet'>");
    line("<link rel='icon' href='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2222%22 fill=%22%2304070d%22/><text x=%2250%22 y=%2268%22 font-size=%2260%22 text-anchor=%22middle%22 fill=%22%2322d3ee%22 font-family=%22monospace%22 font-weight=%22800%22>Y</text></svg>'>");
    line("<style>");
    line(":root{--bg:#04060c;--bg2:#070b14;--panel:rgba(11,17,32,.68);--line:rgba(148,163,184,.14);--txt:#e2e8f0;--mut:#8b98ab;--cy:#22d3ee;--vt:#a78bfa;--ok:#86efac;--grad:linear-gradient(90deg,#22d3ee,#a78bfa)}");
    line("*{margin:0;padding:0;box-sizing:border-box}");
    line("html{scroll-behavior:smooth}");
    line("body{background:var(--bg);color:var(--txt);font-family:'Space Grotesk','Segoe UI',system-ui,-apple-system,sans-serif;line-height:1.65;overflow-x:hidden;min-height:100vh}");
    line("body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(148,163,184,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.05) 1px,transparent 1px);background-size:46px 46px;pointer-events:none;z-index:0;mask-image:radial-gradient(ellipse 90% 62% at 50% -8%,#000 28%,transparent 74%);-webkit-mask-image:radial-gradient(ellipse 90% 62% at 50% -8%,#000 28%,transparent 74%)}");
    line("::selection{background:rgba(34,211,238,.28);color:#fff}");
    line("a{color:inherit}");
    line(":focus-visible{outline:2px solid var(--cy);outline-offset:2px;border-radius:4px}");
    line("code.inline{background:rgba(148,163,184,.12);padding:2px 7px;border-radius:6px;font-size:.88em;font-family:'JetBrains Mono',Consolas,monospace}");
    line(".mono{font-family:'JetBrains Mono',Consolas,monospace}");
    line("");
    line("/* ---------- nav ---------- */");
    line(".nav{position:sticky;top:0;z-index:60;display:flex;align-items:center;gap:22px;padding:15px clamp(20px,4vw,44px);background:rgba(4,6,12,.72);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid transparent;transition:border-color .3s,box-shadow .3s}");
    line(".nav.scrolled{border-color:var(--line);box-shadow:0 10px 30px rgba(0,0,0,.4)}");
    line(".nav .logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:1.22rem;letter-spacing:.4px;color:var(--txt);text-decoration:none}");
    line(".nav .logo .dot{color:var(--cy)}");
    line(".links{display:flex;align-items:center;gap:24px}");
    line(".links a{color:var(--mut);text-decoration:none;font-size:.94rem;font-weight:500;position:relative;padding:4px 0}");
    line(".links a:hover{color:#fff}");
    line(".links a::after{content:'';position:absolute;left:0;right:100%;bottom:0;height:2px;background:var(--grad);transition:right .22s ease}");
    line(".links a:hover::after{right:0}");
    line(".nav .spacer{flex:1}");
    line(".nav .ver{border:1px solid var(--line);border-radius:999px;padding:3px 12px;font-size:.73rem;color:var(--cy);font-family:'JetBrains Mono',Consolas,monospace}");
    line(".nav .cta{background:var(--grad);color:#04121a !important;font-weight:700;padding:10px 20px;border-radius:10px;box-shadow:0 6px 24px rgba(34,211,238,.25)}");
    line(".nav .cta:hover{filter:brightness(1.1);color:#04121a !important}");
    line(".nav .cta::after{display:none}");
    line(".burger{display:none;background:none;border:1px solid var(--line);color:var(--txt);border-radius:9px;padding:8px 13px;font-size:1.05rem;cursor:pointer;font-family:inherit}");
    line("@media(max-width:820px){.links{position:absolute;top:100%;left:0;right:0;display:none;flex-direction:column;align-items:flex-start;gap:16px;background:rgba(4,6,12,.97);padding:20px 24px;border-bottom:1px solid var(--line)}.links.open{display:flex}.burger{display:inline-block}.nav .ver,.nav .cta{display:none}}");
    line("");
    line("/* ---------- hero ---------- */");
    line(".hero{position:relative;z-index:1;text-align:center;padding:110px 24px 40px;overflow:hidden}");
    line(".hero .orb{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;z-index:-1}");
    line(".hero .o1{width:520px;height:520px;background:rgba(34,211,238,.15);top:-160px;left:-120px}");
    line(".hero .o2{width:460px;height:460px;background:rgba(167,139,250,.13);top:-90px;right:-140px}");
    line(".kicker{display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);background:rgba(11,17,32,.6);padding:7px 16px;border-radius:999px;font-size:.78rem;color:var(--mut);letter-spacing:.35px;font-family:'JetBrains Mono',Consolas,monospace}");
    line(".kicker em{font-style:normal;color:var(--vt)}");
    line(".kicker b{color:var(--cy)}");
    line(".hero h1{font-size:clamp(2.7rem,7vw,5.2rem);font-weight:800;letter-spacing:-1.6px;line-height:1.04;margin:28px 0 20px}");
    line(".grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}");
    line(".hero p.lead{font-size:clamp(1.04rem,2.4vw,1.32rem);color:var(--mut);max-width:680px;margin:0 auto 32px}");
    line(".buttons{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}");
    line(".btn{display:inline-flex;align-items:center;gap:9px;text-decoration:none;font-weight:700;border-radius:12px;padding:14px 26px;font-size:1rem;transition:transform .18s ease,box-shadow .18s ease,background .18s ease,border-color .18s ease}");
    line(".btn:hover{transform:translateY(-2px);text-decoration:none}");
    line(".btn.primary{background:var(--grad);color:#04121a;box-shadow:0 12px 36px rgba(34,211,238,.28)}");
    line(".btn.primary:hover{box-shadow:0 16px 46px rgba(34,211,238,.42)}");
    line(".btn.ghost{border:1px solid var(--line);color:var(--txt);background:rgba(11,17,32,.5)}");
    line(".btn.ghost:hover{border-color:rgba(34,211,238,.5);background:rgba(34,211,238,.06)}");
    line(".chips{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:30px}");
    line(".chip{border:1px solid var(--line);background:rgba(11,17,32,.55);color:var(--mut);padding:8px 16px;border-radius:999px;font-size:.82rem;font-family:'JetBrains Mono',Consolas,monospace}");
    line(".chip b{color:var(--cy)}");
    line("");
    line("/* ---------- hero terminal ---------- */");
    line(".term{position:relative;max-width:780px;margin:48px auto 0;text-align:left;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:rgba(7,11,20,.92);box-shadow:0 34px 90px rgba(0,0,0,.55)}");
    line(".term .tbar{display:flex;align-items:center;gap:8px;padding:12px 16px;background:rgba(13,20,34,.6);border-bottom:1px solid var(--line)}");
    line(".term .tbar .dot{width:11px;height:11px;border-radius:50%}");
    line(".term .tbar .name{color:var(--mut);font-family:'JetBrains Mono',Consolas,monospace;font-size:.76rem;margin-left:10px;letter-spacing:.4px}");
    line(".term pre{margin:0;padding:20px 24px;font-family:'JetBrains Mono',Consolas,monospace;font-size:.86rem;line-height:1.62;color:var(--txt);white-space:pre;overflow-x:auto;min-height:220px}");
    line(".cursor{display:inline-block;width:8px;height:16px;background:var(--cy);vertical-align:-2px;animation:blink 1.05s steps(1) infinite}");
    line("@keyframes blink{50%{opacity:0}}");
    line(".term .out{color:var(--ok)}");
    line(".term .dim{color:#4b5865}");
    line("");
    line("/* ---------- ticker ---------- */");
    line(".ticker{position:relative;z-index:1;overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(11,17,32,.4);padding:15px 0;margin-top:56px}");
    line(".ticker .wrap{display:flex;gap:52px;white-space:nowrap;width:max-content;animation:scroll 34s linear infinite}");
    line(".ticker span{font-family:'JetBrains Mono',Consolas,monospace;color:var(--mut);font-size:.85rem}");
    line(".ticker span b{color:var(--cy)}");
    line(".ticker span em{font-style:normal;color:var(--vt)}");
    line("@keyframes scroll{to{transform:translateX(-50%)}}");
    line("@media(prefers-reduced-motion:reduce){.ticker .wrap{animation:none}}");
    line("");
    line("/* ---------- stats ---------- */");
    line(".stats{position:relative;z-index:1;display:grid;grid-template-columns:repeat(4,1fr);gap:18px;max-width:1040px;margin:0 auto;padding:64px clamp(20px,4vw,40px) 10px}");
    line(".stat{text-align:center;padding:26px 12px;border:1px solid var(--line);border-radius:18px;background:rgba(11,17,32,.6)}");
    line(".stat .n{font-size:2.3rem;font-weight:800;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}");
    line(".stat .l{color:var(--mut);font-size:.84rem;margin-top:4px}");
    line("@media(max-width:720px){.stats{grid-template-columns:1fr 1fr}}");
    line("");
    line("/* ---------- sections & cards ---------- */");
    line("section{position:relative;z-index:1;padding:76px clamp(20px,4vw,40px);max-width:1100px;margin:0 auto}");
    line(".eyebrow{text-align:center;font-family:'JetBrains Mono',Consolas,monospace;font-size:.76rem;color:var(--cy);letter-spacing:2.4px;text-transform:uppercase;margin-bottom:12px}");
    line("section h2{font-size:clamp(1.7rem,3.5vw,2.4rem);text-align:center;letter-spacing:-.6px;margin-bottom:12px;line-height:1.15}");
    line("section .desc{color:var(--mut);text-align:center;max-width:660px;margin:0 auto 46px;font-size:1.02rem}");
    line(".grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:20px}");
    line(".card{position:relative;background:rgba(11,17,32,.72);border:1px solid var(--line);border-radius:18px;padding:26px;overflow:hidden;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}");
    line(".card::before{content:'';position:absolute;inset:0;background:radial-gradient(600px 130px at 50% -50px,rgba(34,211,238,.09),transparent);opacity:0;transition:opacity .25s}");
    line(".card:hover{transform:translateY(-4px);border-color:rgba(34,211,238,.4);box-shadow:0 20px 55px rgba(0,0,0,.5)}");
    line(".card:hover::before{opacity:1}");
    line(".card .icon{width:42px;height:42px;border-radius:11px;display:grid;place-items:center;background:rgba(34,211,238,.1);border:1px solid rgba(34,211,238,.25);color:var(--cy);margin-bottom:16px}");
    line(".card .icon svg{width:22px;height:22px}");
    line(".card h3{color:#f1f5f9;margin-bottom:9px;font-size:1.07rem;position:relative;z-index:1}");
    line(".card p{color:var(--mut);font-size:.94rem;position:relative;z-index:1}");
    line("");
    line("/* ---------- code viewer ---------- */");
    line(".codewin{max-width:880px;margin:0 auto;border:1px solid var(--line);border-radius:18px;background:rgba(7,11,20,.94);overflow:hidden;box-shadow:0 34px 90px rgba(0,0,0,.5)}");
    line(".codewin .tabs{display:flex;gap:6px;padding:13px 16px;background:rgba(13,20,34,.6);border-bottom:1px solid var(--line);overflow-x:auto}");
    line(".codewin .tab{border:1px solid transparent;background:none;color:var(--mut);font-family:'JetBrains Mono',Consolas,monospace;font-size:.79rem;padding:7px 14px;border-radius:8px;cursor:pointer;white-space:nowrap;transition:color .15s,background .15s}");
    line(".codewin .tab:hover{color:#fff;background:rgba(148,163,184,.08)}");
    line(".codewin .tab.active{color:#04121a;background:var(--grad);font-weight:700}");
    line(".snipp{display:none;margin:0;padding:22px 24px;font-family:'JetBrains Mono',Consolas,monospace;font-size:.86rem;line-height:1.65;color:var(--txt);overflow-x:auto;max-height:560px}");
    line(".snipp.active{display:block}");
    line("pre .k{color:#c792ea}pre .t{color:#6db3ff}pre .s{color:#c3e88d}pre .f{color:#f78c6c}pre .c{color:#5c6773}pre .u{color:#ffcb6b}");
    line("");
    line("/* ---------- learn ---------- */");
    line(".lcard{display:flex;align-items:center;gap:16px;background:rgba(11,17,32,.72);border:1px solid var(--line);border-radius:16px;padding:18px 20px;text-decoration:none;transition:transform .2s ease,border-color .2s ease}");
    line(".lcard:hover{transform:translateY(-3px);border-color:rgba(34,211,238,.4);text-decoration:none}");
    line(".lcard .f{font-family:'JetBrains Mono',Consolas,monospace;font-size:.8rem;color:var(--cy);white-space:nowrap}");
    line(".lcard .t{flex:1;min-width:0}");
    line(".lcard .t b{display:block;color:#f1f5f9;font-size:.98rem}");
    line(".lcard .t span{color:var(--mut);font-size:.85rem}");
    line(".lcard .ar{color:var(--vt)}");
    line("");
    line("/* ---------- quickstart ---------- */");
    line(".qs .step{display:flex;gap:18px;align-items:flex-start;margin-bottom:26px;max-width:760px;margin-left:auto;margin-right:auto}");
    line(".qs .step .num{flex:0 0 40px;height:40px;border-radius:12px;background:linear-gradient(135deg,rgba(34,211,238,.22),rgba(167,139,250,.22));border:1px solid rgba(34,211,238,.35);color:var(--cy);font-weight:800;display:grid;place-items:center}");
    line(".qs .step p{color:var(--mut);font-size:.96rem;margin-bottom:10px}");
    line(".cmdrow{display:flex;gap:10px;margin-top:6px}");
    line(".cmdrow pre{flex:1;background:rgba(7,11,20,.85);border:1px solid var(--line);border-radius:11px;padding:12px 16px;font-family:'JetBrains Mono',Consolas,monospace;font-size:.85rem;color:#d8e2ee;margin:0;overflow-x:auto}");
    line(".copy{background:rgba(34,211,238,.12);color:var(--cy);border:1px solid rgba(34,211,238,.3);border-radius:9px;padding:10px 14px;font-family:'JetBrains Mono',Consolas,monospace;font-size:.74rem;cursor:pointer;transition:background .15s,transform .15s;white-space:nowrap}");
    line(".copy:hover{background:rgba(34,211,238,.24)}");
    line(".copy:active{transform:scale(.96)}");
    line(".copy.done{color:#04121a;background:var(--grad);border-color:transparent;font-weight:700}");
    line("");
    line("/* ---------- install ---------- */");
    line(".download{position:relative;text-align:center;background:rgba(11,17,32,.7);border:1px solid var(--line);border-radius:26px;padding:52px 28px;overflow:hidden}");
    line(".download::before{content:'';position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:600px;height:300px;background:radial-gradient(closest-side,rgba(34,211,238,.14),transparent);pointer-events:none}");
    line(".dlbtn{position:relative;display:inline-flex;align-items:center;gap:10px;background:var(--grad);color:#04121a;font-weight:800;padding:18px 40px;border-radius:14px;font-size:1.12rem;text-decoration:none;box-shadow:0 16px 48px rgba(34,211,238,.35);transition:transform .18s ease,box-shadow .18s ease}");
    line(".dlbtn:hover{transform:translateY(-3px);box-shadow:0 22px 58px rgba(34,211,238,.45);text-decoration:none}");
    line(".dlsmall{color:var(--mut);margin-top:16px;font-size:.88rem}");
    line(".dlrow{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px;position:relative}");
    line(".mini{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);color:#d8e2ee;padding:10px 18px;border-radius:11px;font-size:.86rem;font-family:'JetBrains Mono',Consolas,monospace;text-decoration:none;transition:border-color .15s,background .15s}");
    line(".mini:hover{border-color:rgba(34,211,238,.5);background:rgba(34,211,238,.06);text-decoration:none}");
    line(".relband{max-width:820px;margin:0 auto 26px;text-align:center;background:linear-gradient(90deg,rgba(34,211,238,.07),rgba(167,139,250,.07));border:1px solid var(--line);color:var(--mut);font-size:.84rem;padding:10px 18px;border-radius:999px;font-family:'JetBrains Mono',Consolas,monospace}");
    line(".relband b{color:var(--cy)}");
    line(".ostabs{display:flex;gap:8px;justify-content:center;margin:36px 0 22px;flex-wrap:wrap}");
    line(".osbtn{background:rgba(11,17,32,.6);border:1px solid var(--line);color:var(--mut);padding:10px 22px;border-radius:10px;font-weight:600;cursor:pointer;font-size:.9rem;font-family:inherit;transition:background .15s,border-color .15s,color .15s}");
    line(".osbtn:hover{border-color:rgba(34,211,238,.4);color:#fff}");
    line(".osbtn.active{background:var(--grad);border-color:transparent;color:#04121a;font-weight:700}");
    line(".pane{display:none;background:rgba(11,17,32,.72);border:1px solid var(--line);border-radius:20px;padding:28px}");
    line(".pane.active{display:block}");
    line(".pane h3{margin-bottom:6px;color:#f1f5f9}");
    line(".pane .note{color:var(--mut);font-size:.92rem;margin-bottom:16px}");
    line(".dltable{width:100%;border-collapse:collapse;margin-top:12px;font-size:.9rem}");
    line(".dltable th{text-align:left;color:#5c6773;font-weight:600;padding:10px 12px;border-bottom:1px solid var(--line);font-size:.72rem;text-transform:uppercase;letter-spacing:.8px}");
    line(".dltable td{padding:12px;border-bottom:1px solid rgba(148,163,184,.08);color:#c9d6e3;vertical-align:middle}");
    line(".dltable td b{color:#eef2f7}");
    line(".dltable .sub{color:#5c6773;font-size:.78rem;display:block;margin-top:2px}");
    line(".dltable .sz{color:var(--mut);white-space:nowrap;font-family:'JetBrains Mono',Consolas,monospace;font-size:.8rem}");
    line(".cardwrap{display:flex;gap:10px;justify-content:flex-end}");
    line("@media(max-width:640px){.dltable{display:block;overflow-x:auto;white-space:nowrap}}");
    line(".sha{text-align:center;color:#5c6773;font-size:.78rem;margin-top:20px}");
    line(".sha a{color:var(--cy)}");
    line("");
    line("/* ---------- faq ---------- */");
    line(".faq details{border:1px solid var(--line);background:rgba(11,17,32,.6);border-radius:14px;padding:18px 22px;margin-bottom:12px;transition:border-color .15s}");
    line(".faq details[open]{border-color:rgba(34,211,238,.35)}");
    line(".faq summary{cursor:pointer;font-weight:700;color:#f1f5f9;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px}");
    line(".faq summary::-webkit-details-marker{display:none}");
    line(".faq summary::after{content:'+';color:var(--cy);font-family:'JetBrains Mono',Consolas,monospace;font-size:1.15rem;transition:transform .2s}");
    line(".faq details[open] summary::after{transform:rotate(45deg)}");
    line(".faq details p{margin-top:12px;color:var(--mut);font-size:.95rem}");
    line("");
    line("/* ---------- footer & extras ---------- */");
    line(".footer{position:relative;z-index:1;border-top:1px solid var(--line);padding:50px clamp(20px,4vw,40px) 40px;text-align:center;color:var(--mut);font-size:.88rem}");
    line(".footer .flinks{display:flex;gap:22px;justify-content:center;flex-wrap:wrap;margin-bottom:18px}");
    line(".footer .flinks a{color:var(--mut);text-decoration:none}");
    line(".footer .flinks a:hover{color:#fff}");
    line(".footer .meta{font-family:'JetBrains Mono',Consolas,monospace;color:#5c6773;font-size:.76rem;margin-top:14px}");
    line(".footer .made{color:var(--vt)}");
    line("#topbtn{position:fixed;right:24px;bottom:24px;z-index:70;width:46px;height:46px;border-radius:12px;border:1px solid var(--line);background:rgba(11,17,32,.9);color:var(--cy);font-size:1.1rem;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;font-family:inherit}");
    line("#topbtn.on{opacity:1;pointer-events:auto}");
    line("#topbtn:hover{transform:translateY(-3px)}");
    line("");
    line("/* ---------- reveal / motion / responsive ---------- */");
    line(".reveal{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease}");
    line(".reveal.show{opacity:1;transform:none}");
    line("@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}.cursor{animation:blink 1.4s steps(1) infinite}}");
    line("@media(max-width:900px){.hero{padding-top:84px}.c2{grid-template-columns:1fr!important}}");
    line("</style>");
    line("</head>");
    line("<body>");
}

// ---------------------------------------------------------------------------
// nav
// ---------------------------------------------------------------------------
public static void nav() {
    line("<nav class='nav' id='nav'>");
