public static void stat(String n, String label) {
    line("<div class='stat'><div class='n'>" + n + "</div><div class='l'>" + label + "</div></div>");
}

public static void stats() {
    line("<div class='stats'>");
    stat("0.1.0", "Latest release");
    stat("1", "Native binary out");
    stat("0", "GC · runtime · magic");
    stat("3", "OS targets · win · mac · linux");
    line("</div>");
}

// ---------------------------------------------------------------------------
// features
// ---------------------------------------------------------------------------
public static void feature(String icon, String title, String desc) {
    line("<div class='card'>");
    line("<div class='icon'>" + icon + "</div>");
    line("<h3>" + title + "</h3>");
    line("<p>" + desc + "</p>");
    line("</div>");
}

public static void features() {
    line("<section id='features'>");
    line("<div class='eyebrow'>Why York</div>");
    line("<h2>Built for how you actually code</h2>");
    line("<p class='desc'>Familiar structure, honest performance, zero ceremony. Here is what makes York worth your time — and what it deliberately skips.</p>");
    line("<div class='grid'>");
    feature("<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M13 2 3 14h9l-1 8 10-12h-9l1-8z'/></svg>", "Fast by design", "A friendly pipeline compiles source straight to native output in seconds. Built for edit-run-fix loops, not coffee breaks.");
    feature("<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='7' y='7' width='10' height='10' rx='2'/><path d='M10 2v4M14 2v4M10 18v4M14 18v4M2 10h4M2 14h4M18 10h4M18 14h4'/></svg>", "Arena memory", "Stack-like arenas with stash semantics. Fast, predictable, and trivially safe — no garbage collector, no pauses, nothing hidden.");
    feature("<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='12 2 2 7 12 12 22 7 12 2'/><polyline points='2 17 12 22 22 17'/><polyline points='2 12 12 17 22 12'/></svg>", "Single native binary", "York compiles down to true native code. Drop the binary anywhere and it just runs — no runtime, no shared libs to chase.");
    feature("<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/><path d='m9 12 2 2 4-4'/></svg>", "Verified downloads", "Every artifact on this site is pinned to a SHA-256 checksum served in the same place. What you see is exactly what runs.");
    feature("<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='16 18 22 12 16 6'/><polyline points='8 6 2 12 8 18'/></svg>", "Familiar syntax", "Typed parameters, methods, enums, loops. The structure you already know — no boilerplate, no ceremony, no learning cliff.");
    feature("<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='4 17 10 11 4 5'/><line x1='12' y1='19' x2='20' y2='19'/></svg>", "One-command install", "A tiny installer puts york on your PATH in one line. Nothing else to install, nothing left dangling, nothing hidden.");
    line("</div>");
    line("</section>");
}

// ---------------------------------------------------------------------------
// code viewer
// ---------------------------------------------------------------------------
public static void snippets_open(String filename) {
    line("<pre class='snipp' data-snip='" + filename + "'><code>");
}

public static void snippets_close() {
    line("</code></pre>");
}

public static void codeline(String html) {
    line(html);
}

public static void codeview() {
    line("<section id='code'>");
    line("<div class='eyebrow'>The language</div>");
    line("<h2>Written the way you already think</h2>");
    line("<p class='desc'>Value semantics by default. When you read from an arena you get a copy — mutation is explicit. Click through the tabs.</p>");
    line("<div class='codewin'>");
    line("<div class='tabs' role='tablist'>");
    line("<button class='tab active' data-snip='hello'>hello.yk</button>");
    line("<button class='tab' data-snip='structs'>structs.yk</button>");
    line("<button class='tab' data-snip='enums'>enums.yk</button>");
    line("<button class='tab' data-snip='arena'>arena.yk</button>");
    line("</div>");
    // hello
    snippets_open("hello");
    codeline("<span class='c'>// hello in York</span>");
    codeline("<span class='k'>public static void</span> <span class='f'>main</span>(<span class='t'>String</span>[] args) {");
    codeline("    <span class='f'>println</span>(<span class='s'>\"Hello, York!\"</span>);");
    codeline("}");
    codeauto("<span class='dim'>$ york run hello.yk</span>");
    codeauto("<span class='s'>Hello, York!</span>");
    snippets_close();
    // structs
    snippets_open("structs");
    codeline("<span class='k'>struct</span> <span class='t'>Player</span> {");
    codeline("    <span class='t'>float</span> pos;");
    codeline("    <span class='t'>float</span> hp;");
    codeline("}");
    codeline("");
    codeline("<span class='k'>impl</span> <span class='t'>Player</span> {");
    codeline("    <span class='t'>void</span> <span class='f'>damage</span>(<span class='t'>float</span> amount) {");
    codeline("        <span class='k'>this</span>.hp -= amount;");
    codeline("        <span class='k'>if</span> (<span class='k'>this</span>.hp &lt; 0.0) { <span class='k'>this</span>.hp = 0.0; }");
    codeline("    }");
    codeline("}");
    snippets_close();
    // enums
    snippets_open("enums");
    codeline("<span class='k'>enum</span> <span class='t'>Dir</span> { <span class='t'>North</span>, <span class='t'>East</span>, <span class='t'>South</span>, <span class='t'>West</span> }");
    codeline("");
    codeline("<span class='k'>void</span> <span class='f'>describe</span>(<span class='t'>Dir</span> d) {");
    codeline("    <span class='k'>switch</span> (d) {");
    codeline("        <span class='k'>case</span> <span class='t'>Dir</span>.North: <span class='f'>println</span>(<span class='s'>\"up\"</span>);   <span class='k'>break</span>;");
    codeline("        <span class='k'>case</span> <span class='t'>Dir</span>.South: <span class='f'>println</span>(<span class='s'>\"down\"</span>); <span class='k'>break</span>;");
    codeline("        <span class='k'>default</span>:       <span class='f'>println</span>(<span class='s'>\"sideways\"</span>);");
    codeline("    }");
    codeline("}");
    snippets_close();
    // arena
    snippets_open("arena");
    codeline("<span class='c'>// a packed little game loop</span>");
    codeline("<span class='t'>Arena</span>&lt;<span class='t'>Player</span>&gt; players = <span class='k'>new</span> <span class='t'>Arena</span>(1000);");
    codeline("players.<span class='f'>push</span>(<span class='t'>Player</span> { pos: 1.0, hp: 100.0 });");
    codeline("");
    codeline("<span class='k'>for</span> (<span class='t'>Player</span> p : players) {");
    codeline("    p.<span class='f'>damage</span>(10.0);");
    codeline("    <span class='f'>println</span>(p.hp);");
    codeline("}");
    snippets_close();
    line("</div>");
    line("</section>");
}

public static void codeauto(String html) {
    codeline(html);
}

// ---------------------------------------------------------------------------
// learn
// ---------------------------------------------------------------------------
public static void lcard(String file, String title, String desc, String url) {
    line("<a class='lcard' href='" + url + "' target='_blank' rel='noopener'>");
    line("<span class='f'>" + file + "</span>");
    line("<span class='t'><b>" + title + "</b><span>" + desc + "</span></span>");
    line("<span class='ar'>→</span>");
    line("</a>");
}

public static void learn() {
    line("<section id='learn'>");
    line("<div class='eyebrow'>Learn York</div>");
    line("<h2>From zero to running — today</h2>");
    line("<p class='desc'>Five tiny lessons, each one compiles and runs. Work through them in order and you are writing York before dinner.</p>");
    line("<div class='grid'>");
    lcard("README.md", "The Learn York guide", "Start here — what each lesson teaches and how to run it", "https://github.com/TheRealClyp/York/blob/main/examples/README.md");
    lcard("hello.yk", "Your first program", "Printing, the entry point, and the run loop", "https://github.com/TheRealClyp/York/blob/main/examples/hello.yk");
    lcard("vars.yk", "Variables & types", "Typed values, mutation, and the basics of data", "https://github.com/TheRealClyp/York/blob/main/examples/vars.yk");
    lcard("funcs.yk", "Functions", "Parameters, return types, and small helpers", "https://github.com/TheRealClyp/York/blob/main/examples/funcs.yk");
    lcard("enums.yk", "Enums & switch", "Type-safe variants and exhaustive branches", "https://github.com/TheRealClyp/York/blob/main/examples/enums.yk");
    lcard("structs.yk", "Structs & impls", "Data with behavior — methods without the ceremony", "https://github.com/TheRealClyp/York/blob/main/examples/structs.yk");
    line("</div>");
    line("</section>");
}

// ---------------------------------------------------------------------------
// quickstart
// ---------------------------------------------------------------------------
public static void qstep(String num, String text, String cmd) {
    line("<div class='step'>");
    line("<div class='num'>" + num + "</div>");
    line("<div>");
    line("<p>" + text + "</p>");
    line("<div class='cmdrow'><pre>" + cmd + "</pre><button class='copy' type='button'>copy</button></div>");
    line("</div>");
    line("</div>");
}

public static void quickstart() {
    line("<section id='quickstart'>");
    line("<div class='eyebrow'>Quickstart</div>");
    line("<h2>Hello, York — in three steps</h2>");
    line("<p class='desc'>Install once, then this is the whole flow. No build files to hand-edit.</p>");
    line("<div class='qs'>");
    qstep("1", "Scaffold a project. York drops a starter <code class='inline'>main.yk</code> you can open and edit.", "york new hello");
    qstep("2", "Step inside and write some code.", "cd hello");
    qstep("3", "Compile to native and run — the whole loop is one command.", "york run main.yk");
    line("</div>");
    line("<div class='term'>");
    line("<div class='tbar'>");
    line("<span class='dot' style='background:#ff5f56'></span>");
    line("<span class='dot' style='background:#ffbd2e'></span>");
    line("<span class='dot' style='background:#27c93f'></span>");
    line("<span class='name'>hello</span>");
    line("</div>");
    line("<pre>");
    line("<span class='dim'>$</span> york run main.yk");
    line("<span class='dim'>compiling hello ...</span>");
    line("<span class='out'>Hello, York!</span>");
    line("<span class='dim'>$</span>");
    line("</pre>");
    line("</div>");
    line("</section>");
}

// ---------------------------------------------------------------------------
// install
// ---------------------------------------------------------------------------
public static void install() {
    line("<section id='install'>");
    line("<div class='eyebrow'>Download</div>");
    line("<h2>Get York</h2>");
    line("<div class='relband'>v0.1.0 · Windows x64 <b>available</b> · Linux x86_64 &amp; arm64 <b>available</b> · SHA-256 verified · macOS on the way</div>");
    line("<div class='download'>");
    line("<a class='dlbtn' id='dlbtn' href='downloads/york-setup-x64.exe'>Download for your OS</a>");
    line("<p class='dlsmall' id='dlhint'>Your OS is auto-detected. Grab the installer or the portable archive.</p>");
    line("<div class='dlrow'>");
    line("<a class='mini' href='downloads/york-setup-x64.exe'>Windows .exe</a>");
    line("<a class='mini' href='downloads/york-x86_64-windows.zip'>Windows .zip</a>");
    line("<a class='mini' href='downloads/york-x86_64-linux.tar.gz'>Linux .tar.gz</a>");
    line("<a class='mini' href='downloads/york.exe'>york.exe</a>");
    line("<a class='mini' href='downloads/SHASUMS256.txt'>checksums</a>");
    line("</div>");
    line("</div>");
    line("<div class='ostabs'>");
    line("<button class='osbtn active' data-os='windows' type='button'>Windows</button>");
    line("<button class='osbtn' data-os='macos' type='button'>macOS</button>");
    line("<button class='osbtn' data-os='linux' type='button'>Linux</button>");
    line("<button class='osbtn' data-os='more' type='button'>Release notes</button>");
    line("</div>");
    // windows
    line("<div class='pane active' data-os='windows'>");
    line("<h3>Windows — everything you need</h3>");
    line("<p class='note'>The installer is the node-style route — double-click, live progress, PATH added, self-verifying. The archive and single-file build are portable.</p>");
    line("<table class='dltable'>");
    line("<tr><th>Artifact</th><th>Why you want it</th><th>Size</th><th></th></tr>");
    line("<tr><td><b>york-setup-x64.exe</b></td><td>GUI installer — live progress, adds PATH, verifies itself<span class='sub'>recommended</span></td><td class='sz'>~ 0.9 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york-setup-x64.exe'>Download</a></div></td></tr>");
    line("<tr><td><b>york-x86_64-windows.zip</b></td><td>Portable — unzip and run <code class='inline'>bin\\york.exe</code><span class='sub'>no install, no PATH changes</span></td><td class='sz'>~ 0.5 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york-x86_64-windows.zip'>Download</a></div></td></tr>");
    line("<tr><td><b>york.exe</b></td><td>Single-file executable — download and run<span class='sub'>simplest possible start</span></td><td class='sz'>~ 1.3 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york.exe'>Download</a></div></td></tr>");
    line("<tr><td>SHASUMS256.txt</td><td>Verified SHA-256 checksums for everything above<span class='sub'>pinned, no mirrors</span></td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='downloads/SHASUMS256.txt'>View</a></div></td></tr>");
    line("</table>");
    line("<div style='height:18px'></div>");
    line("<p class='note'>Or pipe one line and let the installer take over:</p>");
    line("<div class='cmdrow'><pre>irm https://raw.githubusercontent.com/TheRealClyp/York/main/installers/install.ps1 | iex</pre><button class='copy' type='button'>copy</button></div>");
    line("<p class='note' style='margin-top:12px'>Installs to <code class='inline'>%LOCALAPPDATA%\\Programs\\york</code> and adds it to your PATH. 32-bit and ARM64 installers ship with the next release — the compiler already builds clean on both.</p>");
    line("</div>");
    // macos
    line("<div class='pane' data-os='macos'>");
    line("<h3>macOS — command is ready, binary on the way</h3>");
    line("<p class='note'>Binary must be produced on a Mac — there is no way to build it from a Windows machine. The moment the universal build lands it appears right here, SHA-256 verified like everything else, and installs to <code class='inline'>~/.york/bin</code>.</p>");
    line("<div class='cmdrow'><pre>curl -fsSL https://raw.githubusercontent.com/TheRealClyp/York/main/installers/install.sh | sh</pre><button class='copy' type='button'>copy</button></div>");
    line("<p class='note' style='margin-top:12px'>The installer is ready — it is waiting on the binaries. <a class='mini' href='https://github.com/TheRealClyp/York/releases'>Watch releases</a></p>");
    line("</div>");
    // linux
    line("<div class='pane' data-os='linux'>");
    line("<h3>Linux — static binaries for x86_64 &amp; arm64</h3>");
    line("<p class='note'>Fully static builds — zero glibc dependency — so they run on every Linux distro, musl and Alpine included. The one-line installer detects your architecture automatically.</p>");
    line("<table class='dltable'>");
    line("<tr><th>Artifact</th><th>Why you want it</th><th>Size</th><th></th></tr>");
    line("<tr><td><b>york-x86_64-linux.tar.gz</b></td><td>Portable — extract and run <code class='inline'>bin/york</code><span class='sub'>static · no install, no PATH changes</span></td><td class='sz'>~ 0.6 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york-x86_64-linux.tar.gz'>Download</a></div></td></tr>");
    line("<tr><td><b>york-aarch64-linux.tar.gz</b></td><td>ARM64 — Raspberry Pi 4/5, Ampere, Graviton<span class='sub'>static · same compiler, same everything</span></td><td class='sz'>~ 0.6 MB</td><td><div class='cardwrap'><a class='mini' href='downloads/york-aarch64-linux.tar.gz'>Download</a></div></td></tr>");
    line("<tr><td><b>install.sh</b></td><td>One-line installer — auto-detects your arch &amp; OS<span class='sub'>curl • pipe • sh</span></td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='installers/install.sh'>View</a></div></td></tr>");
    line("</table>");
    line("<div style='height:18px'></div>");
    line("<p class='note'>Or pipe one line and let the installer take over:</p>");
    line("<div class='cmdrow'><pre>curl -fsSL https://raw.githubusercontent.com/TheRealClyp/York/main/installers/install.sh | sh</pre><button class='copy' type='button'>copy</button></div>");
    line("<p class='note' style='margin-top:12px'>Installs to <code class='inline'>~/.york/bin</code> and adds it to your PATH. Building a program needs a C compiler (<code class='inline'>gcc</code>/<code class='inline'>clang</code>/<code class='inline'>cc</code>).</p>");
    line("</div>");
    // more
    line("<div class='pane' data-os='more'>");
    line("<h3>Release notes</h3>");
    line("<p class='note'>This distribution ships prebuilt binaries only — the compiler source is not part of the public release.</p>");
    line("<table class='dltable'>");
    line("<tr><th>Item</th><th>Notes</th><th>Size</th><th></th></tr>");
    line("<tr><td><b>install.ps1</b></td><td>One-line installer used by the pipe commands above</td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='installers/install.ps1'>Open</a></div></td></tr>");
    line("<tr><td><b>install.sh</b></td><td>Shell installer for macOS &amp; Linux — fully working with the x86_64 Linux build today</td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='installers/install.sh'>Open</a></div></td></tr>");
    line("<tr><td><b>CHANGELOG.md</b></td><td>What changed in each York release</td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='CHANGELOG.md'>View</a></div></td></tr>");
    line("<tr><td><b>GitHub Releases</b></td><td>Binaries, checksums, and release notes</td><td class='sz'>—</td><td><div class='cardwrap'><a class='mini' href='https://github.com/TheRealClyp/York/releases'>Open</a></div></td></tr>");
    line("</table>");
    line("</div>");
    line("<p class='sha'>Every artifact is signed and verified against its <a href='downloads/SHASUMS256.txt'>SHA-256 checksums</a> — served directly from this site, no mirrors.</p>");
    line("</section>");
}

// ---------------------------------------------------------------------------
// cli cheatsheet
// ---------------------------------------------------------------------------
public static void cheat(String cmd, String desc) {
    line("<div class='card'>");
    line("<h3><code class='inline mono'>" + cmd + "</code></h3>");
    line("<p>" + desc + "</p>");
    line("</div>");
}

public static void cli() {
    line("<section id='cli'>");
    line("<div class='eyebrow'>Cheat sheet</div>");
    line("<h2>The whole CLI on one card</h2>");
    line("<p class='desc'>Six commands cover the entire workflow.</p>");
    line("<div class='grid'>");
    cheat("york new NAME", "Scaffold a fresh project with a starter main.yk.");
    cheat("york build", "Compile the current project to a native binary.");
    cheat("york run FILE", "Compile and run a York source file in one step.");
    cheat("york dev", "Watch your files and rebuild &amp; re-run on every save.");
    cheat("york fmt", "Format your code with the built-in formatter.");
    cheat("york --version", "Confirm which York you are running.");
    line("</div>");
    line("</section>");
}

// ---------------------------------------------------------------------------
// faq
// ---------------------------------------------------------------------------
public static void qa(String q, String a) {
    line("<details>");
    line("<summary>" + q + "</summary>");
    line("<p>" + a + "</p>");
    line("</details>");
}

public static void faq() {
    line("<section id='faq' class='faq'>");
    line("<div class='eyebrow'>FAQ</div>");
    line("<h2>Questions, answered</h2>");
    qa("Do I need anything else installed?", "No. York ships as a prebuilt native binary — the installer just puts it on your PATH. Nothing else to install, nothing dangling.");
    qa("How does York handle memory?", "Arena memory with value semantics: data lives in fast stack-like arenas, you read copies, and mutation is explicit. No garbage collector, no ceremony.");
    qa("Is York production-ready?", "0.1.0 is early but real: structs, impls, enums with switch, arrays, and file I/O all compile fast to native code. More libraries are on the roadmap.");
    qa("Can York run in the browser?", "Soon. The browser backend is in progress, and it compiles the same York source you run natively.");
    qa("How do I uninstall York?", "Delete the install directory — %LOCALAPPDATA%\\Programs\\york on Windows, ~/.york on macOS and Linux — and remove the PATH entry the installer added. Two steps, done.");
    qa("Is this website written in York?", "Yes. This page is generated by a York program — the whole layout, every word, and the scripts. The generator lives in this site's repository.");
    qa("Is York open source?", "This distribution ships free, prebuilt binaries. The compiler source stays private.");
    line("</section>");
}

