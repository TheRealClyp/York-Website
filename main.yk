    line("<main id='top'>");
    line("<div class='hero'>");
    line("<div class='orb o1'></div>");
    line("<div class='orb o2'></div>");
    line("<span class='kicker'>YORK <em>v0.1.0</em> · OUT NOW <b>· FREE BINARIES</b></span>");
    line("<h1>One language.<br><span class='grad'>Zero magic.</span></h1>");
    line("<p class='lead'>York is a fast, simple systems language. Clean syntax, arena memory, and a single native binary — no runtime, no garbage collector, no surprises.</p>");
    line("<div class='buttons'>");
    line("<a class='btn primary' href='#install'>Get York for Windows</a>");
    line("<a class='btn ghost' href='#code'>See the code</a>");
    line("</div>");
    line("<div class='chips'>");
    line("<span class='chip'>latest <b>v0.1.0</b></span>");
    line("<span class='chip'>Windows <b>x64 today</b> — macOS &amp; Linux soon</span>");
    line("<span class='chip'>zero <b>dependencies</b> at runtime</span>");
    line("<span class='chip'>free <b>binaries</b>, no sign-up</span>");
    line("</div>");
    line("<div class='term'>");
    line("<div class='tbar'>");
    line("<span class='dot' style='background:#ff5f56'></span>");
    line("<span class='dot' style='background:#ffbd2e'></span>");
    line("<span class='dot' style='background:#27c93f'></span>");
    line("<span class='name'>hello.yk — york run main.yk</span>");
    line("</div>");
    line("<pre id='heroterm' aria-label='Live York demo'></pre>");
    line("</div>");
    line("</div>");
}

